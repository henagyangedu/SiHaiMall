APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# 本地存储的图片地址前缀，不填则为 APP_URL/uploads。本地开发可填 /uploads（两个前端的开发服务器会把 /uploads 转发给后端）
UPLOADS_URL=
# 支付完成后允许跳回的前端域名，逗号分隔（APP_URL 的域名不用写）。前端和后端不同域名、或本地用 127.0.0.1 访问前端时必须填，否则发起支付会被拒绝
PAY_RETURN_HOSTS=
# 允许跨域访问接口的前端地址，逗号分隔，要带协议，如 https://m.example.com,https://admin.example.com。
# 前端和后端同域名部署时不需要；分域名部署时必须填，否则浏览器会拦掉前端的请求
CORS_ALLOWED_ORIGINS=
# 应用时区：本项目定为北京时间。数据库里的时间按它存，数据统计和每日签到的“一天”按它算。
# 有了真实数据之后不要再改：已有数据的时间会整体偏移
APP_TIMEZONE=Asia/Shanghai
# 站点前面的反向代理 / 负载均衡 / CDN 的 IP，逗号分隔，支持网段（如 10.0.0.0/8）；填 * 表示信任所有代理（只在服务器不能被直接访问时用）。
# 有代理而不填的话，后端看到的访客 IP 全是代理的 IP：限流、验证码的按 IP 限制会把所有访客算成同一个人，很快就会报“操作过于频繁”。
# 没有代理（访客直连 PHP 所在的 Web 服务器）时留空
TRUSTED_PROXIES=
# 会员登录后多少天内免重新登录
MEMBER_TOKEN_DAYS=30
# 首次执行 db:seed 时创建的超级管理员（账号 admin）的密码；留空则随机生成并只在命令行里显示一次
ADMIN_INIT_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 本项目只支持 MySQL 8（初始迁移是 MySQL 的建表语句，表前缀 gm_ 在 config/database.php 里）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gmmall
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
